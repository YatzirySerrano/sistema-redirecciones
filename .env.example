# =============================================================================
#  Sistema de Redirecciones QR/NFC — DASTI
#  Copia este archivo a .env y ajusta los valores. Nunca subas .env al repo.
# =============================================================================

APP_NAME="DASTI Redirecciones"
# local | production
APP_ENV=local
# Genera con: php artisan key:generate  (en producción, una sola vez y respaldada)
APP_KEY=
# En producción SIEMPRE false.
APP_DEBUG=true
# URL pública del sistema. En producción: https://redireccion.dasti.cloud
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Mexico_City

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# En producción se recomienda "daily" y LOG_LEVEL=warning.
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- MariaDB (desarrollo y producción) ---------------------------------------
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sistema_redirecciones
DB_USERNAME=sistema_redirecciones
DB_PASSWORD=
# Alternativa local por socket (deja DB_HOST/DB_PORT y usa autenticación unix_socket):
# DB_SOCKET=/tmp/mysql.sock

# --- Sesiones ----------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En producción (HTTPS): true
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# --- Correo (invitaciones y recuperación de contraseña) ----------------------
# "log" escribe los correos en storage/logs. En producción configura SMTP real.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-responder@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Parámetros del dominio --------------------------------------------------
# Base de los enlaces permanentes (por defecto APP_URL). NO debe cambiar una vez
# entregados QR o tarjetas NFC: es la dirección impresa/grabada.
# DASTI_URL_PUBLICA=https://redireccion.dasti.cloud
# true = registrar accesos mediante cola (requiere `php artisan queue:work`).
# false (por defecto) = se registran tras enviar la respuesta, sin worker.
DASTI_EVENTOS_EN_COLA=false
# Días tras los que se borra la huella anónima diaria de los accesos.
DASTI_DIAS_CONSERVACION_HUELLA=30
# Solicitudes por minuto e IP permitidas sobre /r/{codigo}.
DASTI_LIMITE_REDIRECCIONES=120
# Contraseña de las cuentas de demostración (solo entorno local).
DASTI_DEMO_PASSWORD=Demo-Dasti-2026
